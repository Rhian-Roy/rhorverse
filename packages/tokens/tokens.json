{
  "$schema": "./README.md#schema",
  "color": {
    "night": {
      "50": "#eef0f6", "100": "#d9dce8", "200": "#b3b8cc", "300": "#8a90a8",
      "400": "#646a83", "500": "#474c63", "600": "#33374b", "700": "#24273a",
      "800": "#181a2a", "900": "#10111d", "950": "#08090f"
    },
    "orbit": {
      "50": "#e6fbfb", "100": "#c0f4f3", "200": "#8beae8", "300": "#4fdbd8",
      "400": "#22c7c4", "500": "#0fa9a8", "600": "#0b8788", "700": "#0d6a6c",
      "800": "#0f5456", "900": "#0e4547", "950": "#032a2c"
    },
    "nebula": {
      "50": "#fdeefa", "100": "#fbd6f3", "200": "#f7ade6", "300": "#f17bd4",
      "400": "#e64ebf", "500": "#d02ea6", "600": "#ae2088", "700": "#8b1c6d",
      "800": "#6e1a58", "900": "#5a1849", "950": "#390729"
    },
    "ember": {
      "300": "#ffbe7a", "400": "#ff9f45", "500": "#f97f1c", "600": "#d96210"
    },
    "moss": {
      "300": "#9be3a4", "400": "#6fd27c", "500": "#43b653", "600": "#2f9140"
    },
    "flare": {
      "400": "#ff6b6b", "500": "#ef4444"
    },
    "semantic": {
      "surface": "{night.950}",
      "surface-raised": "{night.900}",
      "surface-overlay": "{night.800}",
      "line": "{night.700}",
      "ink": "{night.50}",
      "ink-muted": "{night.300}",
      "ink-faint": "{night.400}",
      "accent": "{orbit.400}",
      "accent-strong": "{orbit.300}",
      "accent-ink": "{night.950}",
      "highlight": "{nebula.400}",
      "rank": "{ember.400}",
      "success": "{moss.400}",
      "danger": "{flare.400}",
      "focus": "{orbit.300}"
    }
  },
  "font": {
    "display": "var(--font-display-face), ui-sans-serif, system-ui, sans-serif",
    "sans": "var(--font-sans-face), ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "text": {
    "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem",
    "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem", "4xl": "3rem", "hero": "4.5rem"
  },
  "spacing": "0.25rem",
  "radius": {
    "sm": "0.375rem", "md": "0.625rem", "lg": "1rem", "xl": "1.5rem", "pill": "9999px"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "220ms", "slow": "420ms", "hero": "6000ms" },
    "ease": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
