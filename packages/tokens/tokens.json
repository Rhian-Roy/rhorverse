{
  "$schema": "./README.md#schema",
  "color": {
    "ink": {
      "50": "#ECF3EE", "200": "#A9B8AE", "400": "#7E8F84", "700": "#2A3B31",
      "800": "#1E2D24", "850": "#17231C", "900": "#111A15", "950": "#0B110E", "1000": "#06110B"
    },
    "forest": { "700": "#1B4D33", "900": "#0F2A1D" },
    "emerald": { "500": "#1FAE6E", "700": "#146C45" },
    "mint": { "300": "#7BE0B0" },
    "signal": { "400": "#3DFF9A" },
    "amber": { "400": "#E8B04B" },
    "danger": { "400": "#F0716A" },
    "semantic": {
      "surface": "{ink.950}",
      "surface-raised": "{ink.900}",
      "surface-overlay": "{ink.850}",
      "surface-hover": "{ink.800}",
      "line": "{ink.700}",
      "ink": "{ink.50}",
      "ink-muted": "{ink.200}",
      "ink-faint": "{ink.400}",
      "accent": "{emerald.500}",
      "accent-strong": "{mint.300}",
      "accent-ink": "{ink.1000}",
      "link": "{mint.300}",
      "highlight": "{mint.300}",
      "chip-selected": "{forest.700}",
      "chip-selected-ink": "#FFFFFF",
      "brand": "{forest.900}",
      "rank": "{amber.400}",
      "success": "{mint.300}",
      "danger": "{danger.400}",
      "focus": "{signal.400}"
    },
    "semanticLight": {
      "surface": "#F6F8F5",
      "surface-raised": "#FFFFFF",
      "surface-overlay": "#EDF2EC",
      "surface-hover": "#E3EAE4",
      "line": "#CBD6CD",
      "ink": "#0E1A13",
      "ink-muted": "#3E4F44",
      "ink-faint": "#566A5D",
      "accent": "{emerald.700}",
      "accent-strong": "#0F5A39",
      "accent-ink": "#FFFFFF",
      "link": "{emerald.700}",
      "highlight": "{emerald.700}",
      "chip-selected": "{forest.700}",
      "chip-selected-ink": "#FFFFFF",
      "brand": "#DCE7DE",
      "rank": "#8A5A00",
      "success": "{emerald.700}",
      "danger": "#B3261E",
      "focus": "{forest.700}"
    }
  },
  "font": {
    "display": "var(--font-display-face), ui-sans-serif, sans-serif",
    "sans": "var(--font-sans-face), ui-sans-serif, sans-serif",
    "mono": "var(--font-mono-face), ui-monospace, monospace"
  },
  "text": {
    "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem",
    "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem", "4xl": "3rem",
    "display-xl": { "size": "clamp(2.5rem, 1.6rem + 3.2vw, 4.5rem)", "lineHeight": "1.02", "weight": "750" },
    "display-l": { "size": "clamp(2rem, 1.4rem + 2.2vw, 3.5rem)", "lineHeight": "1.05", "weight": "700" },
    "title": { "size": "1.25rem", "lineHeight": "1.2", "weight": "600" },
    "body": { "size": "1rem", "lineHeight": "1.55", "weight": "400" },
    "meta": { "size": "0.8125rem", "lineHeight": "1.4", "weight": "450" }
  },
  "spacing": "0.25rem",
  "radius": { "tile": "0.375rem", "card": "0.625rem", "sheet": "1rem", "pill": "9999px" },
  "shadow": { "focus": "0 16px 40px rgb(0 0 0 / 0.55)" },
  "gradient": {
    "scrim": "linear-gradient(to top, var(--color-surface) 0%, color-mix(in srgb, var(--color-surface) 72%, transparent) 38%, transparent 78%)",
    "canopy-glow": "radial-gradient(70% 90% at 15% 0%, color-mix(in srgb, var(--color-chip-selected) 45%, transparent), transparent 70%)"
  },
  "motion": {
    "duration": { "instant": "90ms", "quick": "160ms", "base": "240ms", "slow": "420ms", "cinematic": "640ms", "rotate": "8000ms" },
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  }
}
