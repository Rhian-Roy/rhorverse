{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just test)",
      "Bash(just test-api)",
      "Bash(just test-web)",
      "Bash(just lint)",
      "Bash(pnpm --filter web lint)",
      "Bash(pnpm --filter web typecheck)",
      "Bash(pnpm --filter web test:e2e)",
      "Bash(pnpm --filter web exec tsc:*)",
      "Bash(pnpm --filter web exec playwright test:*)",
      "Bash(uv run --project services/api pytest:*)",
      "Bash(uv run --project services/api ruff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./data/**)",
      "Bash(cat .env*)",
      "Bash(git push:*)",
      "Bash(git remote add:*)"
    ]
  }
}
