# Copy to .env and fill in. Never commit .env.

# Postgres connection string (local: the canopy-pg container; prod: Supabase pooler URL)
# e.g. postgresql://postgres:<password>@localhost:5432/canopy
DATABASE_URL=
# Password for the local canopy-pg container (used by docker-compose.yml)
POSTGRES_PASSWORD=

# TMDB v4 API Read Access Token (Bearer) — movies, TV, IN watch providers
TMDB_READ_TOKEN=
# Twitch app credentials — IGDB uses Twitch OAuth client-credentials
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# RAWG API key — games fallback/enrichment
RAWG_API_KEY=
# Last.fm API key — tags and similar artists
LASTFM_API_KEY=
# Steam Web API key — GetOwnedGames for Steam import
STEAM_WEB_API_KEY=
# Google Gemini API key — optional LLM facet extraction
GEMINI_API_KEY=
# MusicBrainz requires a descriptive UA: "AppName/version ( contact-email-or-url )"
MUSICBRAINZ_USER_AGENT=

# Public base URL of the API as seen by the browser (e.g. http://localhost:8000)
NEXT_PUBLIC_API_BASE=
# Web data mode: "live" (call the API) or "snapshot" (read /snapshots/*.json)
API_MODE=
# Comma-separated origins allowed by API CORS (e.g. http://localhost:3000)
CORS_ORIGINS=

# --- Accounts (Supabase Auth) ---
# Project URL, e.g. https://<project-ref>.supabase.co. Public. The API also uses it to find the
# signing keys (JWKS) and the token issuer; leave SUPABASE_URL unset and every caller is a guest.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
# Public key for the browser: the "publishable" key (sb_publishable_...), or the legacy "anon" key.
# Set one of the two names.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. The "secret" key (sb_secret_...), or the legacy "service_role" key. Used by the web
# app's server to delete a user. Never prefix with NEXT_PUBLIC_, never commit, never send to the API.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Playwright only: where the sign-up test creates and removes its throwaway user. The test skips
# unless the three Supabase values above are set for the web app and this is "1".
E2E_ACCOUNTS=
